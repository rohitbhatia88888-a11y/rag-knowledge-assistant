{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy demo:7860 {
		# Answers stream as Server-Sent Events; send each chunk as soon as it arrives.
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
