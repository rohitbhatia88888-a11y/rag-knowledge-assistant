# Copy to .env (and backend/.env when running the API outside Docker).
ENV=dev
JWT_SECRET=change-me

# LLM for answers and query rewriting. Without a key, chat returns retrieved sources only.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=   # any OpenAI-compatible endpoint

# Dense embeddings: fastembed (local BGE on CPU) or openai
EMBEDDING_PROVIDER=fastembed
# Cross-encoder; BAAI/bge-reranker-base is stronger but larger
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MIN_RERANK_SCORE=0.0
