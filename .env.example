# Copy to .env (and backend/.env when running the API outside Docker).
ENV=dev
JWT_SECRET=change-me

# LLM for answers and query rewriting. Without a key, chat returns retrieved sources only.
# Any OpenAI-compatible endpoint works; for OpenRouter use its key and base URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5

# Dense embeddings: fastembed (local BGE on CPU) or openai
EMBEDDING_PROVIDER=fastembed
# Cross-encoder; MIN_RERANK_SCORE is the I-dont-know cutoff on the top chunk and depends on the model
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
MIN_RERANK_SCORE=-11.0

# Tracing (optional). Values match docker-compose.langfuse.yml; leave the keys empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
